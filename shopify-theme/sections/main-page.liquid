{%- comment -%}
  Page de contenu. Le corps de la page est du balisage de blocs WordPress
  collé tel quel : `.page-content` lui rend la mise en page contrainte que
  WordPress fabriquait à la volée (voir assets/base.css).

  Deux gabarits s'appuient sur cette section :
    page.json             — le titre est affiché
    page.sans-titre.json  — il ne l'est pas, parce que le contenu ouvre sur
                            son propre bandeau et son propre h1 (l'équivalent
                            de `page-no-title` sous WordPress)
{%- endcomment -%}

<section class="mg-page" style="padding-bottom:var(--wp--preset--spacing--50)">
  {%- if section.settings.show_title -%}
    <div class="mg-inner mg-inner--narrow" style="padding-top:var(--wp--preset--spacing--50)">
      <h1 class="wp-block-heading page-title">{{ page.title }}</h1>
    </div>
  {%- endif -%}

  <div class="page-content">
    {{ page.content }}
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Afficher le titre de la page", "default": true,
      "info": "À décocher quand le contenu commence par son propre bandeau : le titre ferait doublon." }
  ]
}
{% endschema %}
