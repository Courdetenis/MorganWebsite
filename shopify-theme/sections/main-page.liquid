{%- comment -%}
  Page de contenu.

  Les pages du site (À propos, Murales, portfolios, conditions…) sont écrites
  dans le thème, en deux langues : snippets/page-*.liquid, générés depuis
  theme/install/pages.php par scripts/shopify-pages.php. La page Shopify ne
  sert qu'à donner l'adresse — son contenu dans l'admin est ignoré. On la
  reconnaît à son handle, la table est ci-dessous.

  Toute autre page (créée plus tard dans l'admin) s'affiche comme le gabarit
  `page.html` de WordPress : son titre, puis son contenu.
{%- endcomment -%}

<div class="entry-content wp-block-post-content has-global-padding is-layout-constrained wp-block-post-content-is-layout-constrained" style="padding-bottom:var(--wp--preset--spacing--60)">
  {%- case page.handle -%}
    {%- when 'murales' -%}{%- render 'page-murals' -%}
    {%- when 'portfolio' -%}{%- render 'page-portfolio' -%}
    {%- when 'illustration-jeunesse' -%}{%- render 'page-pf-youth' -%}
    {%- when 'illustration' -%}{%- render 'page-pf-illus' -%}
    {%- when 'dessin' -%}{%- render 'page-pf-draw' -%}
    {%- when 'portfolio-murales' -%}{%- render 'page-pf-murals' -%}
    {%- when 'a-propos' -%}{%- render 'page-about' -%}
    {%- when 'commissions-et-collaborations' -%}{%- render 'page-hub' -%}
    {%- when 'commissions' -%}{%- render 'page-commissions' -%}
    {%- when 'collaborations' -%}{%- render 'page-collaborations' -%}
    {%- when 'contact' -%}{%- render 'page-contact' -%}
    {%- when 'conditions-generales-de-vente' -%}{%- render 'page-terms' -%}
    {%- when 'retours-et-remboursements' -%}{%- render 'page-returns' -%}
    {%- when 'confidentialite' -%}{%- render 'page-privacy' -%}
    {%- else -%}
      <div class="wp-block-group alignwide page-head is-layout-flow wp-block-group-is-layout-flow" style="padding-top:var(--wp--preset--spacing--50)">
        <h1 class="wp-block-post-title page-title" style="margin-bottom:var(--wp--preset--spacing--40)">{{ page.title }}</h1>
      </div>
      {{ page.content }}
  {%- endcase -%}
</div>

{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
