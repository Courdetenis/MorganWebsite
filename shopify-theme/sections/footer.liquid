{%- comment -%}
  Pied de page. Même balisage que morgane_render_footer() : réseaux, courriel,
  pages légales, mention. Les coordonnées viennent des réglages de la section —
  l'équivalent de morgane_contact_info(), un seul endroit à changer.
{%- endcomment -%}

{%- assign legal = linklists[section.settings.legal_menu] -%}

<div class="wp-block-group site-footer" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)">
  <div class="site-footer__inner alignwide">

    {%- if section.settings.instagram != blank or section.settings.tiktok != blank -%}
      <nav class="site-footer__social" aria-label="{{ 'general.social' | t }}">
        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" rel="me noopener" target="_blank" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.tiktok != blank -%}
          <a href="{{ section.settings.tiktok }}" rel="me noopener" target="_blank" aria-label="TikTok">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11.6a3.4 3.4 0 1 1-3.4-3.4c.3 0 .6 0 .9.1"/><path d="M14 3c.3 2.6 2 4.4 4.6 4.7"/></svg>
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}

    {%- if section.settings.email != blank -%}
      <a class="site-footer__mail" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
    {%- endif -%}

    <div class="site-footer__legal">
      <nav class="site-footer__links" aria-label="{{ 'general.legal' | t }}">
        {%- if legal.links.size > 0 -%}
          {%- for link in legal.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- else -%}
          {%- comment -%} Sans menu configuré, on retombe sur les politiques de la boutique. {%- endcomment -%}
          {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}
          {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
          {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}
        {%- endif -%}
      </nav>
      <p class="site-footer__copy">© {{ section.settings.name }} – Art · {{ section.settings.city }}</p>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "name", "label": "Nom", "default": "Morgane Cachia" },
    { "type": "text", "id": "city", "label": "Ville", "default": "Montréal, Québec" },
    { "type": "text", "id": "email", "label": "Courriel", "default": "morganecachia.art@gmail.com" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "link_list", "id": "legal_menu", "label": "Menu des pages légales", "default": "footer" }
  ]
}
{% endschema %}
