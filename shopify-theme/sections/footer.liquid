{%- comment -%}
  Pied de page. Même balisage que morgane_render_footer() (theme/inc/contact.php) :
  réseaux, courriel, pages légales, mention. Les coordonnées sont les réglages
  de la section — un seul endroit à changer, dans Personnaliser › Pied de page.
  Attention : les pages Contact, Conditions, Retours et Confidentialité
  recopient le courriel dans leur texte (scripts/shopify-pages.php le lit dans
  theme/inc/contact.php). Le changer ici ne suffit donc pas.
{%- endcomment -%}

{%- liquid
  assign en = false
  if request.locale.iso_code == 'en'
    assign en = true
  endif
  if en
    assign legal = 'Contact|contact;Terms of sale|conditions-generales-de-vente;Returns|retours-et-remboursements;Privacy|confidentialite' | split: ';'
  else
    assign legal = 'Contact|contact;Conditions de vente|conditions-generales-de-vente;Retours|retours-et-remboursements;Confidentialité|confidentialite' | split: ';'
  endif
-%}

<div class="wp-block-group site-footer has-global-padding is-layout-constrained wp-block-group-is-layout-constrained mg-ws-1200" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)">
  <div class="site-footer__inner alignwide">

    <nav class="site-footer__social" aria-label="{% if en %}Social media{% else %}Réseaux sociaux{% endif %}">
      {%- if section.settings.instagram != blank -%}
        <a href="{{ section.settings.instagram }}" rel="me noopener" target="_blank" aria-label="Instagram"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg></a>
      {%- endif -%}
      {%- if section.settings.tiktok != blank -%}
        <a href="{{ section.settings.tiktok }}" rel="me noopener" target="_blank" aria-label="TikTok"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v11.6a3.4 3.4 0 1 1-3.4-3.4c.3 0 .6 0 .9.1"/><path d="M14 3c.3 2.6 2 4.4 4.6 4.7"/></svg></a>
      {%- endif -%}
    </nav>

    {%- if section.settings.email != blank -%}
      <a class="site-footer__mail" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
    {%- endif -%}

    <div class="site-footer__legal">
      <nav class="site-footer__links" aria-label="{% if en %}Legal information{% else %}Informations légales{% endif %}">
        {%- for row in legal -%}
          {%- assign it = row | split: '|' -%}
          <a href="{{ pages[it[1]].url }}">{{ it[0] }}</a>{% unless forloop.last %} {% endunless %}
        {%- endfor -%}
      </nav>
      <p class="site-footer__copy">© {{ section.settings.name }} – Art · {% if en %}{{ section.settings.city_en }}{% else %}{{ section.settings.city }}{% endif %}</p>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "name", "label": "Nom", "default": "Morgane Cachia" },
    { "type": "text", "id": "city", "label": "Ville (français)", "default": "Montréal, Québec" },
    { "type": "text", "id": "city_en", "label": "Ville (anglais)", "default": "Montreal, Quebec" },
    { "type": "text", "id": "email", "label": "Courriel", "default": "morganecachia.art@gmail.com" },
    { "type": "text", "id": "instagram", "label": "Instagram", "default": "https://www.instagram.com/morganecachia/" },
    { "type": "text", "id": "tiktok", "label": "TikTok", "default": "https://www.tiktok.com/@morganecachia" }
  ]
}
{% endschema %}
