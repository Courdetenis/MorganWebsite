<section class="wp-block-group alignwide" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60)">
  <div class="mg-inner">
    <div class="section-head">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="wp-block-heading page-title">{{ page_title }}</h1>
    </div>
    <div class="nav-cards alignwide" data-reveal>
      {%- for collection in collections -%}
        <div class="nav-card">
          <a href="{{ collection.url }}">
            <span class="nav-card__frame">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 780px) 100vw, 390px', alt: collection.title }}
              {%- endif -%}
            </span>
            <span class="nav-card__label">{{ collection.title }}</span>
            <span class="nav-card__note">{{ 'collection.count' | t: count: collection.products_count }}</span>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Liste des collections", "settings": [] }
{% endschema %}
