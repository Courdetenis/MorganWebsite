{%- comment -%} Bandeau de couleur défilant. mg_marquee(). Les mots sont doublés : la boucle CSS a besoin de deux séries pour se recoudre sans saut. {%- endcomment -%}
{%- assign words = section.settings.words | split: ',' -%}
<div class="color-band alignfull is-bleed" aria-hidden="true">
  <div class="marquee">
    {%- for w in words -%}<span>{{ w | strip }}</span>{%- endfor -%}
    {%- for w in words -%}<span>{{ w | strip }}</span>{%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Bandeau défilant",
  "settings": [
    { "type": "text", "id": "words", "label": "Mots (séparés par des virgules)", "default": "Illustration, Peinture, Murales, Montréal, Gouache, Sur mesure" }
  ],
  "presets": [{ "name": "Bandeau défilant" }]
}
{% endschema %}
