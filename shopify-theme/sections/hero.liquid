{%- comment -%}
  Bandeau d'ouverture : fond « aurore », deux formes floues, deux œuvres
  flottantes, titre découpé en mots par app.js. Repris de mg_hero() / du cas
  'home' de pages.php.

  Pas de data-reveal sur les œuvres : la boucle REVEAL d'app.js écarte tout ce
  qui est dans le hero, qui a sa propre ouverture (heroRest).
{%- endcomment -%}

<section class="wp-block-group alignfull hero is-bleed"
         style="min-height:{{ section.settings.min_height }}vh;padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--50)">

  <div class="blob blob--rose" style="width:min(32vw,340px);aspect-ratio:1;top:10%;left:-5%;"></div>
  <div class="blob blob--sage" style="width:min(26vw,280px);aspect-ratio:1;bottom:12%;right:-3%;"></div>

  <figure class="art-float art-float--left">
    {%- if section.settings.float_left != blank -%}
      {{ section.settings.float_left | image_url: width: 600 | image_tag: loading: 'eager', sizes: '210px', alt: section.settings.float_left_alt }}
    {%- else -%}
      <img src="{{ 'art-07.webp' | asset_url }}" alt="{{ section.settings.float_left_alt | escape }}" loading="eager" width="800" height="1000">
    {%- endif -%}
  </figure>
  <figure class="art-float art-float--right">
    {%- if section.settings.float_right != blank -%}
      {{ section.settings.float_right | image_url: width: 600 | image_tag: loading: 'eager', sizes: '210px', alt: section.settings.float_right_alt }}
    {%- else -%}
      <img src="{{ 'art-14.webp' | asset_url }}" alt="{{ section.settings.float_right_alt | escape }}" loading="eager" width="800" height="1000">
    {%- endif -%}
  </figure>

  <div class="wp-block-group hero__inner mg-inner mg-inner--hero">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="wp-block-heading has-text-align-center">{{ section.settings.title }}</h1>

    {%- if section.settings.lede != blank -%}
      <p class="hero__lede has-text-align-center has-large-font-size">{{ section.settings.lede }}</p>
    {%- endif -%}

    {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
      <div class="wp-block-buttons is-content-justification-center">
        {%- if section.settings.button_1_label != blank -%}
          <div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="{{ section.settings.button_1_url | default: routes.all_products_collection_url }}">{{ section.settings.button_1_label }}</a></div>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="{{ section.settings.button_2_url | default: routes.root_url }}">{{ section.settings.button_2_label }}</a></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_cue -%}<div class="scroll-cue" aria-hidden="true"></div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bandeau d'ouverture",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Accroche", "default": "illustration · peinture · murales — Montréal" },
    { "type": "textarea", "id": "title", "label": "Titre", "default": "Des œuvres douces et féeriques pour celles et ceux qui aiment la poésie" },
    { "type": "textarea", "id": "lede", "label": "Chapeau", "default": "Illustratrice, artiste peintre et muraliste basée à Montréal." },
    { "type": "range", "id": "min_height", "label": "Hauteur (vh)", "min": 50, "max": 100, "step": 2, "default": 84, "unit": "vh" },
    { "type": "checkbox", "id": "show_cue", "label": "Indice de défilement", "default": true },
    { "type": "header", "content": "Œuvres flottantes" },
    { "type": "image_picker", "id": "float_left", "label": "Œuvre de gauche" },
    { "type": "text", "id": "float_left_alt", "label": "Texte alternatif — gauche", "default": "Illustration à la gouache : un miroir ancien au sommet d'un escalier de pierre, dans une forêt enchantée" },
    { "type": "image_picker", "id": "float_right", "label": "Œuvre de droite" },
    { "type": "text", "id": "float_right_alt", "label": "Texte alternatif — droite", "default": "Illustration jeunesse : un ourson grimpe à une échelle pour allumer un réverbère dans une ville enneigée" },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "button_1_label", "label": "Bouton 1 — libellé", "default": "Découvrir les œuvres" },
    { "type": "url", "id": "button_1_url", "label": "Bouton 1 — lien" },
    { "type": "text", "id": "button_2_label", "label": "Bouton 2 — libellé", "default": "Travailler ensemble" },
    { "type": "url", "id": "button_2_url", "label": "Bouton 2 — lien" }
  ],
  "presets": [{ "name": "Bandeau d'ouverture" }]
}
{% endschema %}
