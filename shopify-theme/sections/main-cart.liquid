<section class="wp-block-group" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60)">
  <div class="mg-inner mg-inner--narrow">
    <h1 class="wp-block-heading page-title">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="mg-table">
          <thead>
            <tr>
              <th>{{ 'cart.product' | t }}</th>
              <th>{{ 'cart.quantity' | t }}</th>
              <th>{{ 'cart.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="mg-cart-line">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title, class: 'mg-cart-thumb' }}
                    {%- endif -%}
                    <span>
                      <a href="{{ item.url }}">{{ item.product.title }}</a><br>
                      <span class="mg-muted">{{ item.price | money }}</span>
                    </span>
                  </div>
                </td>
                <td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:5rem"></td>
                <td>{{ item.line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <p class="mg-muted" style="margin-top:var(--wp--preset--spacing--30)">{{ 'cart.shipping_note' | t }}</p>
        <p style="font-size:var(--wp--preset--font-size--large)"><strong>{{ 'cart.subtotal' | t }} — {{ cart.total_price | money }}</strong></p>

        <div class="wp-block-buttons">
          <div class="wp-block-button is-style-outline"><button type="submit" name="update" class="wp-block-button__link wp-element-button">{{ 'cart.update' | t }}</button></div>
          <div class="wp-block-button"><button type="submit" name="checkout" class="wp-block-button__link wp-element-button">{{ 'cart.checkout' | t }}</button></div>
        </div>
      </form>
    {%- else -%}
      <p class="mg-notice">{{ 'cart.empty' | t }}</p>
      <div class="wp-block-buttons">
        <div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a></div>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Panier", "settings": [] }
{% endschema %}
