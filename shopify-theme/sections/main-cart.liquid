<section class="wp-block-group" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60)">
  <div class="mg-inner mg-inner--narrow mg-cart">
    <h1 class="wp-block-heading page-title">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="mg-table">
          <thead>
            <tr>
              <th>{{ 'cart.product' | t }}</th>
              <th>{{ 'cart.quantity' | t }}</th>
              <th class="mg-cart__num">{{ 'cart.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="mg-cart-line">
                    {%- if item.image -%}
                      <a href="{{ item.url }}">{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title, class: 'mg-cart-thumb' }}</a>
                    {%- endif -%}
                    <span>
                      <a href="{{ item.url }}">{{ item.product.title }}</a><br>
                      <span class="mg-muted">{{ item.price | money }}</span><br>
                      <a class="mg-cart__remove" href="{{ item.url_to_remove }}" aria-label="{{ 'cart.remove' | t }} : {{ item.product.title | escape }}">{{ 'cart.remove' | t }}</a>
                    </span>
                  </div>
                </td>
                <td>
                  {%- comment -%} Clé de ligne : sans elle, Shopify ignore la modification. {%- endcomment -%}
                  <input class="mg-cart__qty" type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" aria-label="{{ item.product.title }}">
                </td>
                <td class="mg-cart__num">{{ item.line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="mg-cart__summary">
          <p class="mg-muted">{{ 'cart.shipping_note' | t }}</p>
          <p class="mg-cart__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></p>

          <div class="mg-cart__actions">
            <button type="submit" name="update" class="wp-block-button__link wp-element-button is-style-outline">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="wp-block-button__link wp-element-button">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- else -%}
      <p class="mg-notice">{{ 'cart.empty' | t }}</p>
      <div class="wp-block-buttons">
        <div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a></div>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Panier", "settings": [] }
{% endschema %}
