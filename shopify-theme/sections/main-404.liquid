{%- comment -%} 404. Reprend le bandeau et les formes floues du hero — rien de neuf en CSS, comme dans morgane_render_not_found(). {%- endcomment -%}
<section class="wp-block-group alignfull hero is-bleed" style="min-height:62vh;padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)">
  <div class="blob blob--rose" style="width:min(30vw,320px);aspect-ratio:1;top:12%;left:-5%;"></div>
  <div class="blob blob--sage" style="width:min(24vw,260px);aspect-ratio:1;bottom:14%;right:-4%;"></div>

  <div class="wp-block-group hero__inner mg-inner mg-inner--hero">
    <p class="hero__eyebrow">{{ 'not_found.eyebrow' | t }}</p>
    <h1 class="wp-block-heading has-text-align-center">{{ 'not_found.title' | t }}</h1>
    <p class="hero__lede has-large-font-size has-text-align-center">{{ 'not_found.text' | t }}</p>
    <div class="wp-block-buttons is-content-justification-center">
      <div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="{{ routes.root_url }}">{{ 'not_found.home' | t }}</a></div>
      <div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="{{ routes.all_products_collection_url }}">{{ 'not_found.shop' | t }}</a></div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Page 404", "settings": [] }
{% endschema %}
