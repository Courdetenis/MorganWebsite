{%- comment -%}
  En-tête. Reprend trait pour trait le balisage de morgane_render_menu() et
  morgane_render_tools() (theme/inc/blocks.php) : navigation à gauche, logo au
  centre (hors flux), commandes à droite. app.css l'habille sans changement.

  Les entrées sont écrites ici, comme sous WordPress, et non tirées d'un menu
  de navigation Shopify : le site s'affiche juste dès l'installation du thème,
  dans les deux langues, sans rien configurer.
{%- endcomment -%}

{%- liquid
  assign en = false
  if request.locale.iso_code == 'en'
    assign en = true
  endif
  assign r = routes.root_url | append: '/' | replace: '//', '/'
  assign here = request.path | append: '/' | replace: '//', '/'
  # Les pages par `pages[…].url` : l'adresse suit le handle traduit dans Translate & Adapt.
  assign u_murales = pages['murales'].url
  assign u_portfolio = pages['portfolio'].url
  assign u_about = pages['a-propos'].url

  if en
    assign items = 'Home|' | append: r | append: ';Shop|' | append: r | append: 'collections;Murals|' | append: u_murales | append: ';Portfolio|' | append: u_portfolio | append: ';About|' | append: u_about
    assign aside_label = 'Commissions and collaborations'
  else
    assign items = 'Accueil|' | append: r | append: ';Boutique|' | append: r | append: 'collections;Murales|' | append: u_murales | append: ';Portfolio|' | append: u_portfolio | append: ';À propos|' | append: u_about
    assign aside_label = 'Commissions et collaborations'
  endif
  assign aside_url = pages['commissions-et-collaborations'].url
-%}

<div class="wp-block-group site-header has-global-padding is-layout-constrained wp-block-group-is-layout-constrained mg-ws-1200">
  {%- comment -%}
    Pas de classe `is-layout-flow` ici : sous WordPress, la barre a un
    `blockGap` à 0. Avec la classe, base.css pose 1,5rem de marge au-dessus des
    outils, et la barre flex les centre 12 px trop bas.
  {%- endcomment -%}
  <div class="wp-block-group alignwide site-header__bar">

    <nav class="menu" aria-label="{% if en %}Main menu{% else %}Menu principal{% endif %}">
      <button class="menu__trigger" type="button" aria-expanded="false" aria-controls="menu-panel" aria-label="{% if en %}Main menu{% else %}Menu principal{% endif %}">
        <span class="menu__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="menu__trigger-text">Menu</span>
      </button>
      <div class="menu__panel" id="menu-panel">
        <ul class="menu__list">
          {%- assign rows = items | split: ';' -%}
          {%- for row in rows -%}
            {%- assign it = row | split: '|' -%}
            {%- assign url_slash = it[1] | append: '/' | replace: '//', '/' -%}
            {%- assign current = false -%}
            {%- if url_slash == here -%}{%- assign current = true -%}{%- endif -%}
            {%- if forloop.index == 2 -%}
              {%- comment -%}
                « Boutique » mène à la vitrine ; le chevron déroule le raccourci
                vers les rayons. Un rayon dont la collection n'existe pas encore
                est absent — jamais de lien vers une page vide.
              {%- endcomment -%}
              {%- capture rayons -%}
                {%- if collections['prints'].id -%}<li><a href="{{ collections['prints'].url }}">Prints</a></li>{%- endif -%}
                {%- if collections['originaux'].id -%}<li><a href="{{ collections['originaux'].url }}">{% if en %}Originals{% else %}Originaux{% endif %}</a></li>{%- endif -%}
              {%- endcapture -%}
              {%- if rayons != blank -%}
                <li class="menu__item--sub" data-submenu><a href="{{ it[1] }}"{% if current %} aria-current="page"{% endif %}>{{ it[0] }}</a><button class="menu__sub-trigger" type="button" aria-expanded="false" aria-controls="menu-rayons" aria-label="{% if en %}Show the categories{% else %}Afficher les rayons{% endif %}"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9.5 12 15.5 18 9.5"/></svg></button><ul class="menu__sub" id="menu-rayons">{{ rayons }}</ul></li>
                {%- continue -%}
              {%- endif -%}
            {%- endif -%}
            <li><a href="{{ it[1] }}"{% if current %} aria-current="page"{% endif %}>{{ it[0] }}</a></li>
          {%- endfor -%}
        </ul>
        <div class="menu__aside"><ul class="menu__list"><li><a href="{{ aside_url }}"{% if aside_url == request.path %} aria-current="page"{% endif %}>{{ aside_label }}</a></li></ul></div>
      </div>
    </nav>

    <p class="site-header__brand wp-block-site-title">
      <a href="{{ r }}" rel="home">{{ shop.name }}</a>
    </p>

    {%- liquid
      if en
        assign tools_label = 'Language, theme, account and cart'
      else
        assign tools_label = 'Langue, thème, compte et panier'
      endif
    -%}
    <div class="site-header__tools" data-tools>
      <button class="tools__trigger" type="button" aria-expanded="false" aria-controls="tools-panel" aria-label="{{ tools_label }}" title="{{ tools_label }}">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="19" cy="12" r="1.9"/></svg>
        {%- if cart.item_count > 0 -%}<span class="tools__badge" aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
      </button>

      <div class="tools__panel" id="tools-panel">

        {%- comment -%}
          Langue : le formulaire de langue de Shopify, et non des liens qui
          changent le préfixe (/en/…). Shopify renvoie lui-même à l'adresse de
          la même page dans l'autre langue, handle traduit compris (Translate &
          Adapt) : /en/pages/murals ↔ /pages/murales. Un lien qui garde le
          handle menait à /pages/murals, qui n'existe pas en français.
          Des boutons d'envoi : rien à faire en JS, ça marche sans.
          N'apparaît que si la boutique publie plus d'une langue.
        {%- endcomment -%}
        {%- if localization.available_languages.size > 1 -%}
          {%- assign lang_label = 'Choix de la langue' -%}
          {%- if en -%}{%- assign lang_label = 'Language' -%}{%- endif -%}
          <div class="lang-switch" data-lang-switch>
            <button class="lang-switch__trigger" type="button" aria-expanded="false" aria-controls="lang-panel" aria-label="{{ lang_label }}" title="{{ lang_label }}">{{ request.locale.iso_code | upcase }}</button>
            {%- form 'localization', id: 'lang-panel', class: 'lang-switch__panel' -%}
              <input type="hidden" name="return_to" value="{{ request.path }}">
              {%- for language in localization.available_languages -%}
                {%- assign is_current = false -%}
                {%- if language.iso_code == request.locale.iso_code -%}{%- assign is_current = true -%}{%- endif -%}
                <button class="lang-switch__item{% if is_current %} is-active{% endif %}" type="submit" name="language_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if is_current %} aria-current="true"{% endif %}>{{ language.iso_code | upcase }}</button>
              {%- endfor -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- assign theme_label = 'Thème clair / sombre' -%}
        {%- if en -%}{%- assign theme_label = 'Light / dark theme' -%}{%- endif -%}
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="{{ theme_label }}" title="{{ theme_label }}"><svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.3 6.3 4.8 4.8M19.2 19.2l-1.5-1.5M17.7 6.3l1.5-1.5M4.8 19.2l1.5-1.5"/></svg><svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13.4A8.2 8.2 0 0 1 10.6 4a8.4 8.4 0 1 0 9.4 9.4Z"/></svg></button>

        {%- if shop.customer_accounts_enabled -%}
          {%- liquid
            if customer
              assign account_label = 'Mon compte'
              if en
                assign account_label = 'My account'
              endif
            else
              assign account_label = 'Se connecter'
              if en
                assign account_label = 'Sign in'
              endif
            endif
          -%}
          <a class="account-link{% if customer %} is-connected{% endif %}" href="{{ routes.account_url }}" aria-label="{{ account_label }}" title="{{ account_label }}"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.6"/><path d="M4.8 20.2a7.2 7.2 0 0 1 14.4 0"/></svg></a>
        {%- endif -%}

        {%- liquid
          if cart.item_count > 0
            if en
              assign cart_label = 'Cart, ' | append: cart.item_count | append: ' item(s)'
            else
              assign cart_label = 'Panier, ' | append: cart.item_count | append: ' article(s)'
            endif
          else
            assign cart_label = 'Panier'
            if en
              assign cart_label = 'Cart'
            endif
          endif
        -%}
        <a class="cart-link" href="{{ routes.cart_url }}" aria-label="{{ cart_label }}"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 8h13l-1.1 11.1a1.6 1.6 0 0 1-1.6 1.4H8.2a1.6 1.6 0 0 1-1.6-1.4Z"/><path d="M9 8V6.4a3 3 0 0 1 6 0V8"/></svg>{%- if cart.item_count > 0 -%}<span class="cart-link__badge">{{ cart.item_count }}</span>{%- endif -%}</a>

      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "En-tête",
  "settings": []
}
{% endschema %}
