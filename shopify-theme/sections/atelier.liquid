{%- comment -%}
  « L'atelier » : la mise en scène du bandeau d'ouverture, mais au fil de la
  page. mg_atelier(). Les œuvres portent data-reveal — hors du hero, elles
  apparaissent au défilement.
{%- endcomment -%}
<section class="wp-block-group alignfull atelier is-bleed" style="padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)">

  <div class="blob blob--rose" style="width:min(30vw,320px);aspect-ratio:1;top:8%;left:-6%;"></div>
  <div class="blob blob--sage" style="width:min(24vw,260px);aspect-ratio:1;bottom:10%;right:-4%;"></div>

  <figure class="art-float art-float--left" data-reveal>
    {%- if section.settings.float_left != blank -%}
      {{ section.settings.float_left | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '210px', alt: section.settings.float_left_alt }}
    {%- else -%}
      <img src="{{ 'art-09.webp' | asset_url }}" alt="{{ section.settings.float_left_alt | escape }}" loading="lazy" width="800" height="1000">
    {%- endif -%}
  </figure>
  <figure class="art-float art-float--right" data-reveal>
    {%- if section.settings.float_right != blank -%}
      {{ section.settings.float_right | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '210px', alt: section.settings.float_right_alt }}
    {%- else -%}
      <img src="{{ 'art-06.webp' | asset_url }}" alt="{{ section.settings.float_right_alt | escape }}" loading="lazy" width="800" height="1000">
    {%- endif -%}
  </figure>

  <div class="mg-inner mg-inner--atelier">
    {%- if section.settings.eyebrow != blank -%}<p class="has-text-align-center eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="wp-block-heading has-text-align-center">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="has-text-align-center has-large-font-size" style="margin-top:var(--wp--preset--spacing--30)">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="wp-block-buttons is-content-justification-center">
        <div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="{{ section.settings.button_url | default: routes.root_url }}">{{ section.settings.button_label }}</a></div>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "L'atelier",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Accroche", "default": "L'atelier" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Entre magie et mélancolie" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "J'aime peindre des personnages et faire apparaître leurs histoires et leurs âmes, dans mes illustrations à la gouache comme dans mes murales." },
    { "type": "text", "id": "button_label", "label": "Bouton — libellé", "default": "Rencontrer Morgane" },
    { "type": "url", "id": "button_url", "label": "Bouton — lien" },
    { "type": "header", "content": "Œuvres flottantes" },
    { "type": "image_picker", "id": "float_left", "label": "Œuvre de gauche" },
    { "type": "text", "id": "float_left_alt", "label": "Texte alternatif — gauche", "default": "Illustration à la gouache : une fée assise au cœur d'une pivoine rose immense" },
    { "type": "image_picker", "id": "float_right", "label": "Œuvre de droite" },
    { "type": "text", "id": "float_right_alt", "label": "Texte alternatif — droite", "default": "Illustration à la gouache : une femme aux longs cheveux serre une lune lumineuse dans une forêt d'hiver bleutée" }
  ],
  "presets": [{ "name": "L'atelier" }]
}
{% endschema %}
