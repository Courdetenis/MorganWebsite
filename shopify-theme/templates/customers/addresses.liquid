<section class="wp-block-group" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60)"><div class="mg-inner mg-inner--narrow">
  <h1 class="wp-block-heading page-title">{{ 'customer.addresses' | t }}</h1>
  {%- for address in customer.addresses -%}
    <div class="mg-notice" style="margin-bottom:1rem">{{ address | format_address }}</div>
  {%- else -%}
    <p class="mg-muted">—</p>
  {%- endfor -%}
  <p><a href="{{ routes.account_url }}">{{ 'customer.account' | t }}</a></p>
</div></section>
