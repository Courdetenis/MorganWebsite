<section class="wp-block-group" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60)"><div class="mg-inner mg-inner--narrow">
  <h1 class="wp-block-heading page-title">{{ 'customer.order' | t }} {{ order.name }}</h1>
  <p class="mg-muted">{{ order.created_at | date: '%-d %B %Y' }}</p>
  <table class="mg-table">
    <tbody>
      {%- for line in order.line_items -%}
        <tr><td>{{ line.title }} × {{ line.quantity }}</td><td>{{ line.final_line_price | money }}</td></tr>
      {%- endfor -%}
      <tr><td><strong>{{ 'customer.total' | t }}</strong></td><td><strong>{{ order.total_price | money }}</strong></td></tr>
    </tbody>
  </table>
</div></section>
