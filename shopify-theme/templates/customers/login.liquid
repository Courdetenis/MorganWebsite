<section class="wp-block-group" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60)"><div class="mg-inner mg-inner--narrow">
  <h1 class="wp-block-heading page-title">{{ 'customer.login' | t }}</h1>
  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}
    <div class="mg-field"><label for="cl-email">{{ 'customer.email' | t }}</label><input type="email" id="cl-email" name="customer[email]" autocomplete="email"></div>
    <div class="mg-field"><label for="cl-pass">{{ 'customer.password' | t }}</label><input type="password" id="cl-pass" name="customer[password]" autocomplete="current-password"></div>
    <div class="wp-block-buttons"><div class="wp-block-button"><button type="submit" class="wp-block-button__link wp-element-button">{{ 'customer.login' | t }}</button></div></div>
  {%- endform -%}
  <p style="margin-top:var(--wp--preset--spacing--30)"><a href="{{ routes.account_register_url }}">{{ 'customer.register' | t }}</a></p>
</div></section>
