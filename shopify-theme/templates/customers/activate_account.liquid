<section class="wp-block-group" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60)"><div class="mg-inner mg-inner--narrow">
  <h1 class="wp-block-heading page-title">{{ 'customer.account' | t }}</h1>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="mg-field"><label for="ac1">{{ 'customer.password' | t }}</label><input type="password" id="ac1" name="customer[password]" autocomplete="new-password"></div>
    <div class="mg-field"><label for="ac2">{{ 'customer.password' | t }}</label><input type="password" id="ac2" name="customer[password_confirmation]" autocomplete="new-password"></div>
    <div class="wp-block-buttons"><div class="wp-block-button"><button type="submit" class="wp-block-button__link wp-element-button">{{ 'customer.register' | t }}</button></div></div>
  {%- endform -%}
</div></section>
