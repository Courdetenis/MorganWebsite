<section class="wp-block-group" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--60)"><div class="mg-inner mg-inner--narrow">
  <h1 class="wp-block-heading page-title">{{ 'customer.account' | t }}</h1>
  <p class="mg-muted">{{ customer.email }} · <a href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a></p>
  <h2 class="wp-block-heading">{{ 'customer.orders' | t }}</h2>
  {%- if customer.orders.size > 0 -%}
    <table class="mg-table">
      <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.status' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
      <tbody>
        {%- for order in customer.orders -%}
          <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%-d %B %Y' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money }}</td></tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- else -%}
    <p class="mg-notice">{{ 'customer.no_orders' | t }}</p>
  {%- endif -%}
  <p style="margin-top:var(--wp--preset--spacing--30)"><a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }}</a></p>
</div></section>
