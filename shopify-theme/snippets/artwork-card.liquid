{%- comment -%}
  Carte d'œuvre. Transposition de theme/woocommerce/content-product.php :
  mêmes classes, donc même habillage par app.css — cadre coloré quand il n'y a
  pas de photo, pastille « Vendu », prix sous le titre.

  Paramètres :
    product      — produit Shopify (facultatif)
    demo_image   — nom de fichier dans assets/, pour la démonstration hors boutique
    demo_title   — titre de démonstration
    demo_price   — prix de démonstration (chaîne déjà formatée)
{%- endcomment -%}

{%- if product -%}
  {%- assign has_image = false -%}
  {%- if product.featured_image -%}{%- assign has_image = true -%}{%- endif -%}

  <li class="product artwork">
    <a class="artwork__link" href="{{ product.url }}">
      <span class="artwork__frame{% unless has_image %} artwork__frame--empty{% endunless %}">
        {%- if has_image -%}
          {%- assign alt = product.featured_image.alt | default: product.title -%}
          {{ product.featured_image | image_url: width: 800 | image_tag:
             loading: 'lazy', sizes: '(max-width: 820px) 50vw, 300px',
             widths: '300,600,800', alt: alt }}
        {%- endif -%}
        {%- if product.available == false -%}
          <span class="artwork__badge artwork__badge--out">{{ 'product.sold_out' | t }}</span>
        {%- elsif product.compare_at_price > product.price -%}
          <span class="artwork__badge">{{ 'product.sale' | t }}</span>
        {%- endif -%}
      </span>
      <span class="artwork__body">
        <span class="artwork__title">{{ product.title }}</span>
        <span class="artwork__price">{{ product.price | money }}</span>
      </span>
    </a>

    {%- if product.available -%}
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="button add_to_cart_button">{{ 'product.add_to_cart' | t }}</button>
      </form>
    {%- endif -%}
  </li>

{%- else -%}
  {%- comment -%}
    Aucune boutique branchée : tuile de démonstration, pour que la mise en page
    se voie sur une boutique vide. Non cliquable, et annoncée comme telle.
  {%- endcomment -%}
  <li class="product artwork">
    <span class="artwork__link">
      <span class="artwork__frame{% unless demo_image %} artwork__frame--empty{% endunless %}">
        {%- if demo_image -%}
          <img src="{{ demo_image | asset_url }}" alt="" loading="lazy" width="800" height="1000">
        {%- endif -%}
      </span>
      <span class="artwork__body">
        <span class="artwork__title">{{ demo_title }}</span>
        <span class="artwork__price">{{ demo_price }}</span>
      </span>
    </span>
  </li>
{%- endif -%}
