{%- comment -%}
  Généré par scripts/shopify-pages.php depuis theme/install/pages.php (clé « pf_youth »).
  Ne pas modifier ici : changer le texte dans pages.php, puis relancer le script.
{%- endcomment -%}
{%- assign r = routes.root_url | append: '/' | replace: '//', '/' -%}
{%- if request.locale.iso_code == 'en' -%}
<section class="wp-block-group alignfull hero has-global-padding is-layout-constrained wp-block-group-is-layout-constrained mg-cs-1240" style="min-height:72vh;padding-top:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60)">

<div class="blob blob--rose" style="width:min(34vw,360px);aspect-ratio:1;top:6%;left:-7%;"></div>
<div class="blob blob--sage" style="width:min(26vw,290px);aspect-ratio:1;bottom:8%;right:-5%;"></div>

<div class="wp-block-group hero-split is-layout-flow wp-block-group-is-layout-flow">

<div class="hero__media"><img src="{{ 'art-11.webp' | asset_url }}" width="1171" height="1600" alt="Children’s illustration: a fawn and a puppy meet in a snowy forest of violet tones" decoding="async" loading="eager" fetchpriority="high"></div>

<div class="wp-block-group hero-split__text is-layout-flow wp-block-group-is-layout-flow">

<p class="hero__eyebrow">Portfolio</p>

<h1 class="wp-block-heading">Children’s illustration</h1>

<div class="wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex">
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="{{ pages['portfolio'].url }}">All the portfolios</a></div>
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="{{ pages['commissions'].url }}">Commission an illustration</a></div>
</div>
</div>
</div>
</section>


<section class="wp-block-group alignwide has-global-padding is-layout-constrained wp-block-group-is-layout-constrained mg-cs-1240" style="padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)">

<div class="wp-block-group section-head is-layout-flow wp-block-group-is-layout-flow">
<p class="eyebrow">The series</p>

<h2 class="wp-block-heading">The works</h2>
</div>

<figure class="wp-block-gallery alignwide has-nested-images columns-default is-style-strip is-layout-flex wp-block-gallery-is-layout-flex">

<figure class="wp-block-image size-large"><img src="{{ 'art-11.webp' | asset_url }}" alt="Children’s illustration: a fawn and a puppy meet in a snowy forest of violet tones" class="wp-image-11" width="1171" height="1600"/></figure>

<figure class="wp-block-image size-large"><img src="{{ 'art-12.webp' | asset_url }}" alt="Children’s illustration: a mouse waters primroses outside her home carved into a tree" class="wp-image-12" width="1067" height="1600"/></figure>

<figure class="wp-block-image size-large"><img src="{{ 'art-13.webp' | asset_url }}" alt="Children’s illustration: a little girl in a pink dress holds her teddy bear during a picnic" class="wp-image-13" width="1128" height="1600"/></figure>

<figure class="wp-block-image size-large"><img src="{{ 'art-14.webp' | asset_url }}" alt="Children’s illustration: a teddy bear climbs a ladder to light a street lamp in a snowy town" class="wp-image-14" width="1062" height="1600"/></figure>

<figure class="wp-block-image size-large"><img src="{{ 'art-15.webp' | asset_url }}" alt="Children’s illustration: a little girl plants a seedling in a rose garden, watched by a white goose" class="wp-image-15" width="1089" height="1600"/></figure>
</figure>
</section>


<div class="wp-block-group alignwide prose is-layout-flow wp-block-group-is-layout-flow">
<hr class="wp-block-separator rule"/>


<p>A custom illustration, or a piece that is already available?</p>


<div class="wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex">
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="{{ pages['commissions'].url }}">Commission an illustration</a></div>
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="{{ r }}collections">Browse the shop</a></div>
</div>
</div>
